  "keyFeatures": [
    "Reverse proxy host management with load balancing, health checks, and custom headers",
    "L4 TCP/UDP stream proxying with TLS SNI matching and proxy protocol support",
    "Automatic HTTPS via Caddy ACME (Let's Encrypt / ZeroSSL) with DNS-01 challenge support",
    "Web Application Firewall powered by Coraza with OWASP Core Rule Set",
    "Geo blocking by country, continent, ASN, CIDR, or IP per proxy host",
    "Mutual TLS (mTLS) with built-in CA, client certificate issuance/revocation, and RBAC",
    "Built-in forward auth identity provider (no external IdP required)",
    "Traffic analytics with ClickHouse backend: live charts, country map, WAF event log",
    "Full REST API under /api/v1/ with OpenAPI 3.1.0 documentation",
    "Multi-instance master/slave configuration sync",
    "OAuth2/OIDC SSO with any compliant provider",
    "Complete audit trail for all configuration changes"
  ],
  "publicApiSurface": [
    "GET/POST /api/v1/proxy-hosts",
    "GET/PUT/DELETE /api/v1/proxy-hosts/{id}",
    "GET/POST /api/v1/l4-proxy-hosts",
